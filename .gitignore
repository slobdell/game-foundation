# Godot's per-machine cache. Regenerated by `make import`.
.godot/
# The pinned toolchain from `make bootstrap`. Both lines: `.tools` may be a symlink, and "dir/" never matches a link.
.tools
.tools/
# Everything `make` produces: exports, screenshots, pages, logs.
/build/
node_modules/
__pycache__/
*.pyc
*.tmp
.DS_Store
# Keys never live in the repo (they are in ~/.config/game-foundation/keys.env).
*.env
# Raw Meshy downloads are big (10-20 MB each) and only needed to re-fit a model. They stay on this computer;
# the .json beside each (task id, prompt, license) IS committed. The fitted model in assets/models/ is what ships.
assets/incoming/*
!assets/incoming/*.json
!assets/incoming/.gdignore
